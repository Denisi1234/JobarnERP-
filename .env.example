APP_NAME=FrontDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://frontdesk.test
APP_TIMEZONE="UTC"

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Railway — Postgres is cheapest single deploy (no Docker needed, pdo_pgsql already available)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=secret
DATABASE_URL=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Hardened: use database for queued SMS retries (SendNextSmsJob tries 3, backoff 60/300/900) — run php artisan queue:work
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# NextSMS Tanzania — auto SMS on first check-in at the duka
# Account: mahenge328432.929 (mahenge328432@gmail.com) / SenderID JOBARN
NEXTSMS_ENABLED=true
NEXTSMS_API_URL=https://messaging-service.co.tz/api/sms/v1/text/single
# Use EITHER API_KEY or USERNAME+PASSWORD — get from https://www.nextsms.co.tz > API Settings
NEXTSMS_API_KEY=
NEXTSMS_USERNAME=mahenge328432.929
NEXTSMS_PASSWORD=
NEXTSMS_SENDER_ID=JOBARN
NEXTSMS_TEST_PHONE=
NEXTSMS_LOG_ONLY=false
NEXTSMS_TEMPLATE_FIRST="Karibu {name} katika duka la JOBARN! Asante kwa kututembelea mara ya kwanza. Host wako ni {host}. Badge yako: {badge}. Tunakuhudumia kwa furaha!"
NEXTSMS_TEMPLATE_RETURNING="Karibu tena {name}! Tunafurahi kukuona tena dukani. Host wako: {host}. Badge: {badge}. Asante!"
NEXTSMS_TEMPLATE_CHECKOUT="Asante {name} kwa kututembelea duka la JOBARN! Ume-checkout {time} — Badge {badge}. Karibu tena! www.jobarn.co.tz"
